# Disable directory listing
Options -Indexes

# Block all dotfiles (.env, .git, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive project files
<FilesMatch "^(composer\.(json|lock)|Makefile|Dockerfile|docker-compose\.yml|README\.md|CLAUDE\.md|LICENSE)$">
    Require all denied
</FilesMatch>

# Block access to vendor directory.
# Deliberately not wrapped in <IfModule>: without mod_rewrite this should fail
# loudly (500) rather than silently serve vendor/.
RewriteEngine On
RewriteRule ^vendor(/|$) - [F,L]
