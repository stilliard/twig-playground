# Disable directory listing
Options -Indexes

# Block all dotfiles (.env, .git, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive project files
<FilesMatch "^(composer\.(json|lock)|Makefile|Dockerfile|docker-compose\.yml|README\.md|CLAUDE\.md|LICENSE)$">
    Require all denied
</FilesMatch>

# Block access to vendor directory (mod_alias, so no mod_rewrite needed)
RedirectMatch 404 ^/vendor(/|$)
